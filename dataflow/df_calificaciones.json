{
	"name": "df_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "calificaciones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(calificacion_id = upper(trim(calificacion_id)),",
				"          pedido_id = upper(trim(pedido_id)),",
				"          cliente_id = upper(trim(cliente_id)),",
				"          fecha_calificacion = trim(fecha_calificacion),",
				"          puntuacion = trim(toString(puntuacion)),",
				"          comentario = trim(comentario)) ~> derivedColumn1",
				"derivedColumn1 split(isNull(calificacion_id) || trim(calificacion_id) == '' || isNull(pedido_id) || trim(pedido_id) == '' || isNull(cliente_id) || trim(cliente_id) == '' || isNull(fecha_calificacion) || trim(fecha_calificacion) == '' || !isDate(fecha_calificacion) || isNull(puntuacion) || trim(puntuacion) == '' || !isInteger(puntuacion) || toInteger(puntuacion) < 1 || toInteger(puntuacion) > 5 || isNull(comentario) || trim(comentario) == '',",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos derive(fecha_calificacion = toDate(fecha_calificacion),",
				"          puntuacion = toInteger(puntuacion)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          venta_id as string,",
				"          fecha_venta as date,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          venta_id = calificacion_id,",
				"          fecha_venta = fecha_calificacion,",
				"          cliente_id,",
				"          sucursal_id = pedido_id,",
				"          canal = puntuacion,",
				"          medio_pago = comentario",
				"     )) ~> sink1"
			]
		}
	}
}