{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(pedido_id = upper(trim(pedido_id)),",
				"          fecha_pedido = trim(fecha_pedido),",
				"          hora_pedido = trim(hora_pedido),",
				"          cliente_id = upper(trim(cliente_id)),",
				"          sucursal_id = upper(trim(sucursal_id)),",
				"          canal = initCap(lower(trim(canal))),",
				"          tipo_servicio = initCap(lower(trim(tipo_servicio))),",
				"          estado_pedido = initCap(lower(trim(estado_pedido))),",
				"          promocion_id = initCap(lower(trim(promocion_id))),",
				"          subtotal = trim(toString(subtotal)),",
				"          costo_delivery = trim(toString(costo_delivery)),",
				"          descuento = trim(toString(descuento)),",
				"          impuesto = trim(toString(impuesto)),",
				"          total_pedido = trim(toString(total_pedido))) ~> derivedColumn1",
				"derivedColumn1 split(isNull(pedido_id) || trim(pedido_id) == '' || isNull(fecha_pedido) || trim(fecha_pedido) == '' || isNull(hora_pedido) || trim(hora_pedido) == '' || isNull(cliente_id) || trim(cliente_id) == '' || isNull(sucursal_id) || trim(sucursal_id) == '' || isNull(canal) || trim(canal) == '' || isNull(tipo_servicio) || trim(tipo_servicio) == '' || isNull(estado_pedido) || trim(estado_pedido) == '' || !isDecimal(subtotal) || !isDecimal(costo_delivery) || !isDecimal(descuento) || !isDecimal(impuesto) || !isDecimal(total_pedido) || toDecimal(total_pedido) < 0 || toDecimal(descuento) > toDecimal(subtotal),",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos derive(fecha_pedido = toDate(fecha_pedido),",
				"          subtotal = toDecimal(subtotal,10,2),",
				"          costo_delivery = toDecimal(costo_delivery,10,2),",
				"          descuento = toDecimal(descuento,10,2),",
				"          impuesto = toDecimal(impuesto,10,2),",
				"          total_pedido = toDecimal(total_pedido,10,2)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          venta_id as string,",
				"          fecha_venta as date,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          venta_id = pedido_id,",
				"          fecha_venta = fecha_pedido,",
				"          cliente_id = hora_pedido,",
				"          sucursal_id = cliente_id,",
				"          canal = tipo_servicio,",
				"          total_venta = descuento,",
				"          promocion_id,",
				"          total_venta = total_pedido,",
				"          total_venta = subtotal,",
				"          medio_pago = estado_pedido",
				"     )) ~> sink1"
			]
		}
	}
}