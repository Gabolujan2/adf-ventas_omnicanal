{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = upper(trim(repartidor_id)),",
				"          nombre_repartidor = trim(nombre_repartidor),",
				"          tipo_vehiculo = initCap(lower(trim(tipo_vehiculo))),",
				"          ciudad_base = iif(upper(trim(ciudad_base)) == 'CBA', 'Cochabamba', trim(ciudad_base)),",
				"          fecha_alta = trim(fecha_alta),",
				"          activo = initCap(lower(trim(activo)))) ~> derivedColumn1",
				"derivedColumn1 split(isNull(repartidor_id) || trim(repartidor_id) == '' || isNull(nombre_repartidor) || trim(nombre_repartidor) == '' || isNull(tipo_vehiculo) || trim(tipo_vehiculo) == '' || isNull(ciudad_base) || trim(ciudad_base) == '' || isNull(fecha_alta) || trim(fecha_alta) == '' || !isDate(fecha_alta) || isNull(activo) || trim(activo) == '' || (     lower(trim(activo)) != 'sí' &&     lower(trim(activo)) != 'si' &&     lower(trim(activo)) != 'no' ),",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos derive(fecha_alta = toDate(fecha_alta)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          venta_id as string,",
				"          fecha_venta as date,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          venta_id = repartidor_id,",
				"          fecha_venta = fecha_alta,",
				"          cliente_id = nombre_repartidor,",
				"          sucursal_id = tipo_vehiculo,",
				"          canal = ciudad_base,",
				"          estado_venta = activo",
				"     )) ~> sink1"
			]
		}
	}
}